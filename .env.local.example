# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MerchFlow app links (defaults shown; set per environment on Vercel)
NEXT_PUBLIC_TRACKER_URL=https://gms-inventory-tracker.vercel.app
NEXT_PUBLIC_CHARTS_URL=https://merch-flow-charts.vercel.app
NEXT_PUBLIC_FLOW_URL=https://gms-merch-flow-intelligence.vercel.app
# TestFlight link once available; defaults to ${NEXT_PUBLIC_TRACKER_URL}/pos
NEXT_PUBLIC_POS_URL=

# Shared with MerchFlow Charts. Charts sends it as the x-merchflow-link header
# when it reads /api/tours/[id]/merch-flow-data. Same value in both apps.
MERCHFLOW_LINK_SECRET=
